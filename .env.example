# This project has two services, each with its own .env file:
#
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env.local
#
# This root file just summarizes both for convenience -- see the per-service
# files for authoritative documentation of each variable.

# ---- backend/.env ----------------------------------------------------
DATABASE_URL=sqlite:///./route53.db
SESSION_SECRET_KEY=dev-insecure-secret-change-me
SESSION_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# ---- frontend/.env.local ----------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
