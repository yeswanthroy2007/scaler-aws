# Copy this file to .env and adjust values as needed.

# SQLAlchemy database URL (SQLite file relative to backend/ working directory)
DATABASE_URL=sqlite:///./route53.db

# Secret used to sign mock session tokens. Change this in any non-local environment.
SESSION_SECRET_KEY=dev-insecure-secret-change-me

# Session lifetime in seconds (default: 12 hours)
SESSION_TTL_SECONDS=43200

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ENVIRONMENT=development
